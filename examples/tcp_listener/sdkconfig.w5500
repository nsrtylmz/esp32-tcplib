# Wi-Fi + W5500 SPI Ethernet, as tested (ESP32, SPI2).
# Use for a fresh configuration (delete sdkconfig first):
#   idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.w5500" build
CONFIG_EXAMPLE_CONNECT_WIFI=y
CONFIG_EXAMPLE_CONNECT_ETHERNET=y
CONFIG_EXAMPLE_USE_W5500=y
CONFIG_EXAMPLE_ETH_SPI_HOST=1
CONFIG_EXAMPLE_ETH_SPI_SCLK_GPIO=12
CONFIG_EXAMPLE_ETH_SPI_MOSI_GPIO=27
CONFIG_EXAMPLE_ETH_SPI_MISO_GPIO=14
CONFIG_EXAMPLE_ETH_SPI_CS_GPIO=13
CONFIG_EXAMPLE_ETH_SPI_CLOCK_MHZ=20
CONFIG_EXAMPLE_ETH_SPI_INT_GPIO=26
CONFIG_EXAMPLE_ETH_PHY_RST_GPIO=25
CONFIG_EXAMPLE_ETH_PHY_ADDR=1
