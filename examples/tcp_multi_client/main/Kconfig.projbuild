        choice MULTI_CLIENT3_IFACE
            prompt "Network interface"
            default MULTI_CLIENT3_IFACE_ANY
            depends on MULTI_CLIENT3_ENABLE
            help
                Interface this client's socket is bound to (TcpOptions::netif_key).

            config MULTI_CLIENT3_IFACE_ANY
                bool "Any (routing decides)"
            config MULTI_CLIENT3_IFACE_WIFI_STA
                bool "Wi-Fi station (WIFI_STA_DEF)"
            config MULTI_CLIENT3_IFACE_ETH
                bool "Ethernet (ETH_DEF)"
            config MULTI_CLIENT3_IFACE_CUSTOM
                bool "Custom esp_netif key"
        endchoice

        config MULTI_CLIENT3_IFACE_KEY
            string "esp_netif key"
            default "WIFI_STA_DEF"
            depends on MULTI_CLIENT3_IFACE_CUSTOM
