        choice MULTI_CLIENT2_IFACE
            prompt "Network interface"
            default MULTI_CLIENT2_IFACE_WIFI_STA
            depends on MULTI_CLIENT2_ENABLE
            help
                Interface this client's socket is bound to (TcpOptions::netif_key).

            config MULTI_CLIENT2_IFACE_ANY
                bool "Any (routing decides)"
            config MULTI_CLIENT2_IFACE_WIFI_STA
                bool "Wi-Fi station (WIFI_STA_DEF)"
            config MULTI_CLIENT2_IFACE_ETH
                bool "Ethernet (ETH_DEF)"
            config MULTI_CLIENT2_IFACE_CUSTOM
                bool "Custom esp_netif key"
        endchoice

        config MULTI_CLIENT2_IFACE_KEY
            string "esp_netif key"
            default "WIFI_STA_DEF"
            depends on MULTI_CLIENT2_IFACE_CUSTOM
    endmenu

    menu "Client 3"
        config MULTI_CLIENT3_ENABLE
            bool "Enable client 3"
            default y

        config MULTI_CLIENT3_HOST
            string "Server address (empty = default)"
            default ""
            depends on MULTI_CLIENT3_ENABLE

        config MULTI_CLIENT3_PORT
            int "Server port (0 = default)"
            range 0 65535
